    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "web:dev": "pnpm --filter @deepdeck/web dev",
    "web:build": "pnpm --filter @deepdeck/web build",
    "web:check": "pnpm --filter @deepdeck/web check",
    "webmcp:sync": "node --import ./vendor/deepseek-harness/node_modules/tsx/dist/loader.mjs scripts/sync-webmcp-registry.ts",
    "bootstrap": "pnpm harness:install && pnpm harness:build && pnpm codex-connect:install && pnpm build",
    "harness:install": "node scripts/install-harness.mjs",
    "harness:build": "node --import ./vendor/deepseek-harness/node_modules/tsx/dist/loader.mjs scripts/build-harness.ts && node scripts/harness-build-cache.mjs record",
    "codex-connect:deps": "node scripts/ensure-codex-connect-dependencies.mjs",
    "codex-connect:install": "pnpm install --frozen-lockfile && pnpm codex-connect:check",
    "codex-connect:check": "pnpm harness:ensure && pnpm codex-connect:deps && node scripts/verify-codex-connect-patch.mjs && pnpm --dir vendor/dsh-codex-connect run typecheck",
    "codex-connect:test": "pnpm codex-connect:check && pnpm --dir vendor/dsh-codex-connect run test",
    "codex-connect:build": "pnpm codex-connect:check",
    "build:desktop": "pnpm harness:ensure && pnpm codex-connect:build && pnpm --filter @deepdeck/dsh-app-market-desktop-bridge run build && pnpm --filter @deepdeck/dsh-bun-plugin-builder run build && pnpm --filter @deepdeck/dsh-first-run run build && pnpm --filter @deepdeck/dsh-app-conversations run build && pnpm --filter @deepdeck/dsh-computer-use run build && pnpm --filter @deepdeck/dsh-provider-aware-web run build && pnpm --filter @deepdeck/dsh-browser run build && pnpm --filter @deepdeck/dsh-client-ui-desktop-chrome run build && pnpm --filter @deepdeck/dsh-client-ui-home-hero run build && pnpm --filter @deepdeck/dsh-client-ui-agent-preset-sections run build && pnpm --filter @deepseek-harness/desktop run build && node scripts/start-build-cache.mjs record",
    "build": "pnpm build:desktop && pnpm web:build && pnpm --filter @deepdeck/webmcp-index build",
    "check": "pnpm harness:ensure && pnpm codex-connect:check && pnpm --filter @deepdeck/dsh-app-market-desktop-bridge run check && pnpm --filter @deepdeck/dsh-bun-plugin-builder run check && pnpm --filter @deepdeck/dsh-first-run run check && pnpm --filter @deepdeck/dsh-app-conversations run check && pnpm --filter @deepdeck/dsh-computer-use run check && pnpm --filter @deepdeck/dsh-provider-aware-web run check && pnpm --filter @deepdeck/dsh-browser run check && pnpm --filter @deepdeck/dsh-client-ui-desktop-chrome run check && pnpm --filter @deepdeck/dsh-client-ui-home-hero run check && pnpm --filter @deepdeck/dsh-client-ui-agent-preset-sections run check && pnpm --filter @deepseek-harness/desktop run check && pnpm web:check && pnpm --filter @deepdeck/webmcp-index check",
    "test:start-cache": "node --test scripts/start-build-cache.test.mjs scripts/harness-build-cache.test.mjs scripts/runtime-footprint.test.mjs",
    "test:questions": "pnpm --filter @deepdeck/dsh-client-ui-desktop-chrome build && vendor/deepseek-harness/node_modules/.bin/vitest run --config apps/desktop/scripts/question-composer.vitest.config.ts",
    "test": "pnpm test:start-cache && pnpm test:registry && pnpm test:signing && pnpm test:browser-benchmark && pnpm test:webmcp-benchmark && pnpm codex-connect:test && pnpm --filter @deepdeck/dsh-app-market-desktop-bridge run test && pnpm --filter @deepdeck/dsh-bun-plugin-builder run test && pnpm --filter @deepdeck/dsh-first-run run test && pnpm --filter @deepdeck/dsh-app-conversations run test && pnpm --filter @deepdeck/dsh-computer-use run test && pnpm --filter @deepdeck/dsh-provider-aware-web run test && pnpm --filter @deepdeck/dsh-browser run test && pnpm --filter @deepseek-harness/desktop run test && pnpm --filter @deepdeck/webmcp-index test",
    "computer-use:update": "node scripts/update-computer-use-version.mjs",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "runtime:verify": "node scripts/verify-runtime.mjs",
    "package:local": "pnpm build && pnpm runtime:prepare && node scripts/build-desktop-package.mjs --local && node scripts/verify-desktop-package.mjs --local",
    "package:mac": "pnpm build && pnpm runtime:prepare && node scripts/build-desktop-package.mjs --mac && node scripts/verify-desktop-package.mjs --production",
    "package:verify": "node scripts/verify-desktop-package.mjs --local",
    "start": "node scripts/start-desktop.mjs",
    "start:raw": "node scripts/start-desktop.mjs",
    "start:rebuild": "pnpm build:desktop && node scripts/run-desktop.mjs",
    "start:packaged": "pnpm package:local && node scripts/run-packaged-desktop.mjs",
    "test:registry": "node --import ./vendor/deepseek-harness/node_modules/tsx/dist/loader.mjs --test scripts/sync-webmcp-registry.test.mjs",
    "test:signing": "node --test scripts/signing-scan.test.mjs",
    "test:browser-benchmark": "node --test apps/desktop/scripts/browser-use-benchmark.test.mjs",
    "benchmark:browser": "node apps/desktop/scripts/verify-browser-devtools.mjs --benchmark",
    "test:harness-ui": "node apps/desktop/scripts/verify-harness-ui.mjs",
    "harness:ensure": "node scripts/harness-build-cache.mjs",
    "benchmark:webmcp": "node scripts/webmcp-benchmark.mjs",
    "test:webmcp-benchmark": "node --test scripts/published-model-benchmark.test.mjs scripts/webmcp-benchmark.test.mjs scripts/webmcp-comparison.test.mjs scripts/webmcp-model-config.test.mjs scripts/webmcp-ablation.test.mjs && pnpm --filter @deepdeck/webmcp-bench test"
  },
