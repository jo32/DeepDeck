+describe('startup artifact cache invalidation', () => {
+  it('keeps activation snapshots across unrelated arrivals and refreshes them on rebuild', async () => {
+    const id = '@fixture/cached-first'
+    const extra = '@fixture/cached-extra'
+    writeBuiltPackage(id, {})
+    writeBuiltPackage(extra, {})
+    const entries = [id]
+    const { context, service, route } = constructWithRoute(entries)
+    const initial = service.graph().entries.find(entry => entry.id === id)!
+    const before = await routeRequest(route, initial.url)
+    writeFileSync(service.clientPath(id)!, 'module.exports = { changed: true }\n')
+    entries.push(extra)
+    emitLoaderEntryChange(context, extra)
+    await Promise.resolve()
+    expect((await routeRequest(route, initial.url)).body).toEqual(before.body)
+    service.rebuilt(id)
+    const next = service.graph().entries.find(entry => entry.id === id)!
+    expect(next.rev).not.toBe(initial.rev)
+    expect((await routeRequest(route, next.url)).body.toString()).toContain('changed: true')
+  })
+
+  it('does not reuse an old batch after a plugin is removed and mounted with new bytes', async () => {
+    const id = '@fixture/cached-remount'
+    writeBuiltPackage(id, {})
+    const entries = [id]
+    const { context, service, route } = constructWithRoute(entries)
+    const clientPath = service.clientPath(id)!
+    const initial = service.graph().batches![0]!
+    entries.pop()
+    emitLoaderEntryChange(context, id)
+    await Promise.resolve()
+    expect(service.graph().entries).toEqual([])
+    writeFileSync(clientPath, 'module.exports = { remounted: true }\n')
+    entries.push(id)
+    emitLoaderEntryChange(context, id)
+    await Promise.resolve()
+    const next = service.graph().batches![0]!
+    expect(next.url).not.toBe(initial.url)
+    expect((await routeRequest(route, next.url)).body.toString()).toContain('remounted: true')
+    expect((await routeRequest(route, initial.url)).status).toBe(404)
+  })
