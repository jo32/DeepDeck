diff --git alib/network-retry.js b/lib/network-retry.js
new file mode 100644
index 0000000000000000000000000000000000000000..f5f58f67013a88b5d070ddcda9bdb28e7aa06d78
--- /dev/null
+++ b/lib/network-retry.js
@@ -0,0 +1,46 @@
+'use strict';
+
+const UUID = '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}';
+const NETWORK_ERROR = /Code=-(?:1001|1005|1009|1200)\b|\b(?:ECONNRESET|ETIMEDOUT|EAI_AGAIN|ENOTFOUND)\b|network connection was lost|Internet connection appears to be offline|No network route|timed out/i;
+
+function submissionId(output) {
+  try {
+    const parsed = JSON.parse(output.trim());
+    if (typeof parsed.id === 'string' && new RegExp(`^${UUID}$`, 'i').test(parsed.id)) return parsed.id;
+  } catch {}
+  return new RegExp(`/submissions/(${UUID})`, 'i').exec(output)?.[1];
+}
+
+async function runAppleToolWithRetry(operation, originalArgs, {
+  attempts = 4,
+  sleep = ms => new Promise(resolve => setTimeout(resolve, ms)),
+  report = message => console.warn(message),
+} = {}) {
+  let args = originalArgs;
+  for (let attempt = 0; attempt < attempts; attempt++) {
+    let result;
+    let failure;
+    try { result = await operation(args); } catch (error) { failure = error; }
+    const output = failure ? String(failure.message) : String(result.output ?? '');
+    if (!failure && result.code === 0) return result;
+    if (!NETWORK_ERROR.test(output) || attempt === attempts - 1) {
+      if (failure) throw failure;
+      return result;
+    }
+    if (args[0] === 'submit') {
+      // Resume Apple's existing submission. An unknown outcome must never
+      // cause another upload or be treated as an accepted notarization.
+      const id = submissionId(output);
+      if (!id) {
+        if (failure) throw failure;
+        return result;
+      }
+      args = ['wait', id, ...args.slice(2).filter(arg => arg !== '--wait'), '--timeout', '10m'];
+    }
+    // Arguments contain credentials: never include them or raw output here.
+    report(`Apple network request interrupted; retrying (${attempt + 2}/${attempts}).`);
+    await sleep([5000, 15000, 30000][Math.min(attempt, 2)]);
+  }
+}
+
+exports.runAppleToolWithRetry = runAppleToolWithRetry;
