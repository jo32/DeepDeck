{
  "name": "@deepdeck/dsh-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Site Agents and WebMCP Builder in the DeepDeck browser",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./contracts": {
      "types": "./lib/types/contracts.d.ts",
      "default": "./lib/contracts.js"
    },
    "./native-contract": {
      "types": "./src/native-contract.d.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepdeck/dsh-client-ui-desktop-chrome",
        "@deepdeck/dsh-client-ui-home-hero"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "../../vendor/deepseek-harness/node_modules/.bin/tsc -p tsconfig.json && ../../vendor/deepseek-harness/node_modules/.bin/tsdown --config tsdown.config.ts",
    "check": "../../vendor/deepseek-harness/node_modules/.bin/tsc -p tsconfig.json --noEmit",
    "test": "../../vendor/deepseek-harness/node_modules/.bin/vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "chrome-devtools-mcp": "1.8.0",
    "esbuild": "^0.25.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/types/**/*.d.ts",
    "src/native-contract.d.ts",
    "cordis.patch.yml",
    "README.md"
  ]
}
