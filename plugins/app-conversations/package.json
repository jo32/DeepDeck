{
  "name": "@deepdeck/dsh-app-conversations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "App-scoped workspaces and canonical conversation routing for DeepDeck",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/types/contracts.d.ts",
      "default": "./lib/contracts.js"
    },
    "./app-settings-contract": {
      "types": "./src/app-settings-contract.d.ts"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "../../vendor/deepseek-harness/node_modules/.bin/tsc -p tsconfig.json && ../../vendor/deepseek-harness/node_modules/.bin/tsdown --config tsdown.config.ts",
    "check": "../../vendor/deepseek-harness/node_modules/.bin/tsc -p tsconfig.json --noEmit",
    "test": "../../vendor/deepseek-harness/node_modules/.bin/vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "react": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/types/**/*.d.ts",
    "src/app-settings-contract.d.ts",
    "skills/**",
    "cordis.patch.yml",
    "README.md"
  ]
}
