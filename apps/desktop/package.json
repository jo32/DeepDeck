{
  "name": "@deepseek-harness/desktop",
  "productName": "OpenWorkBuddy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build && node scripts/build-preload.mjs",
