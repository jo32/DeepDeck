{
  "name": "@deepseek-harness/desktop",
  "productName": "DeepDeck",
  "version": "1.0.29",
  "description": "DeepDeck desktop client",
  "author": "jo32",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && node scripts/write-vibeloft-telemetry-config.mjs && vite build && node scripts/build-preload.mjs",
    "check": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@vibeloft/telemetry-electron": "0.1.0",
    "electron-updater": "^6.8.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
