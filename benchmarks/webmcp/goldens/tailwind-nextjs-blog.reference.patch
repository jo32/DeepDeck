+// Full-text index for the ask_site WebMCP tool: published posts, the About
+// author, and projects — unlike search.json, it keeps the raw body so the
+// tool can return content excerpts, not just titles.
+function createAskSiteIndex(allBlogs, allAuthors) {
+  const published = sortPosts(allBlogs).filter((post) => post.draft !== true)
+  const posts = published.map((post) => ({
+    kind: 'post',
+    title: post.title,
+    date: post.date,
+    tags: post.tags,
+    summary: post.summary,
+    path: `/${post.path}`,
+    body: post.body.raw,
+  }))
+  // A co-author has no /about page of their own; they are reachable only through
+  // the posts that list them — and only PostLayout actually renders the author
+  // (name, avatar, link), so PostSimple/PostBanner posts are not a page where the
+  // visitor can see them. Map each non-default author to the newest published
+  // PostLayout post that lists them, and cite that page as the source.
+  const rendersAuthors = (post) => !post.layout || post.layout === 'PostLayout'
+  const postForAuthor: Record<string, string> = {}
+  for (const post of published) {
+    if (!rendersAuthors(post)) continue
+    for (const authorSlug of post.authors ?? []) {
+      if (authorSlug !== 'default' && !(authorSlug in postForAuthor)) {
+        postForAuthor[authorSlug] = `/${post.path}`
+      }
+    }
+  }
+  // `keywords` name the questions a page owns but does not literally answer: the
+  // About body never says "author", so "who is the author" cannot match it on
+  // words alone. Only claim what the doc can answer — the contact keywords are
+  // earned by indexing the frontmatter contact fields below, which the page
+  // renders but the body text does not contain. Posts need no keywords: their
+  // titles and tags already say what they are.
+  const about = allAuthors
+    .filter((author) => author.slug === 'default' || postForAuthor[author.slug])
+    .map((author) => {
+      const isDefault = author.slug === 'default'
+      const contact = Object.entries({
+        email: author.email,
+        twitter: author.twitter,
+        linkedin: author.linkedin,
+        github: author.github,
+      })
+        .filter(([, v]) => v)
+        .map(([k, v]) => `${k}: ${v}`)
+      return {
+        kind: 'author',
+        title: `About ${author.name}`,
+        summary: [author.occupation, author.company].filter(Boolean).join(' at '),
+        keywords: ['about', 'author', 'wrote', 'bio', 'biography', 'profile', 'contact'],
+        // Default author -> /about; a co-author -> the post where they appear.
+        path: isDefault ? '/about' : postForAuthor[author.slug],
+        body: [author.body.raw, contact.length ? `Contact — ${contact.join(', ')}` : '']
+          .filter(Boolean)
+          .join('\n\n'),
+      }
+    })
+  // href is the project's own link (external site or an on-site post); without it
+  // "where is the search engine project" can be answered but not followed.
+  const projects = projectsData.map((project) => ({
+    kind: 'project',
+    title: project.title,
+    summary: project.description,
+    keywords: ['project', 'projects', 'portfolio', 'work'],
+    path: '/projects',
+    link: project.href,
+    body: [project.description, project.href ? `Link: ${project.href}` : '']
+      .filter(Boolean)
+      .join('\n'),
+  }))
+  writeFileSync('public/ask-site-index.json', JSON.stringify([...posts, ...about, ...projects]))
+  console.log('ask_site index generated...')
+}
+
